# Sao chép file này thành .env rồi chỉnh lại nếu cần:  cp .env.example .env
#
# Môi trường mặc định khi không truyền TEST_ENV (dev | staging | prod)
TEST_ENV=dev

# URL gốc của hệ thống
BASE_URL=https://crm.anhtester.com

# Đường dẫn tương đối tới trang login
LOGIN_PATH=/admin/authentication

# Thông tin đăng nhập (CI nên inject qua secrets, không commit giá trị thật)
APP_USERNAME=admin@example.com
APP_PASSWORD=123456

# Bật log chi tiết trong quá trình chạy test
DEBUG_LOG=false
