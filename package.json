{
  "name": "crm-e2e-framework",
  "version": "1.0.0",
  "description": "Modern Playwright + TypeScript E2E Web UI Automation Framework (Anh Tester CRM)",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:headed": "cross-env HEADED=true playwright test --project=chromium --workers=1",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:smoke": "playwright test --grep @smoke",
    "test:dev": "cross-env TEST_ENV=dev playwright test",
    "test:staging": "cross-env TEST_ENV=staging playwright test",
    "test:prod": "cross-env TEST_ENV=prod playwright test",
    "report": "playwright show-report reports/html",
    "codegen": "playwright codegen https://crm.anhtester.com/admin/authentication",
    "install:browsers": "playwright install --with-deps",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.9.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.3"
  }
}
